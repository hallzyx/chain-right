# ChainRight - Environment Variables
# Copy this file as .env and fill in the values

# ============================================
# 0G Network (Testnet - Galileo)
# ============================================

# 0G Chain RPC
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_CHAIN_ID=16602

# Server-side RPC (backend actions)
RPC_URL=https://evmrpc-testnet.0g.ai

# Storage Indexer
NEXT_PUBLIC_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Server-side storage indexer (backend actions)
STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# ============================================
# Wallet
# ============================================

# Private key for deploy, server actions, and Telegram agent
# NEVER commit this to the repo. NEVER use in production carelessly.
PRIVATE_KEY=your_private_key_here

# ============================================
# ChainRightERC721 Contract
# ============================================

# Deployed contract address (v3)
# v3: 0xfca49910C81355eE3787e4E87F16a18E593bedB0 (0G Testnet)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xfca49910C81355eE3787e4E87F16a18E593bedB0

# ============================================
# 0G Compute Providers (Auto-Discovery)
# ============================================

# No need to configure providers manually.
# The system auto-discovers providers via:
#   discoverProviders("text-to-image")
#   discoverProviders("image-editing")
#   discoverProviders("chatbot")
#
# Active testnet providers:
#   Text-to-Image: flux-turbo (TEE-verified)
#   Image Editing: qwen/qwen-image-edit-2511 (TEE-verified)
#   Chatbot:       qwen/qwen-2.5-7b-instruct (TEE-verified)

# ============================================
# Telegram Bot (Autonomous Agent)
# ============================================

# Bot token created via @BotFather
# Required to run: npm run agent
TELEGRAM_BOT_TOKEN=

# ============================================
# NOTE: DeepSeek API has been replaced
# ============================================

# DEEPSEEK_API_KEY is no longer needed.
# The agent now uses 0G Compute (qwen/qwen-2.5-7b-instruct) for NLP and Function Calling.
# Falls back to keyword matching if no providers are available.
# DeepSeek removed in Pivot 03.

# ============================================
# 0G Mainnet (Aristotle) - uncomment for production
# ============================================

# NEXT_PUBLIC_RPC_URL=https://evmrpc.0g.ai
# NEXT_PUBLIC_CHAIN_ID=16661
# NEXT_PUBLIC_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
