# ChainRight - Variables de Entorno
# Copiá este archivo como .env y completá los valores

# ============================================
# 0G Network (Testnet - Galileo)
# ============================================

# RPC de 0G Chain
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_CHAIN_ID=16602

# Storage Indexer
NEXT_PUBLIC_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# ============================================
# Wallet
# ============================================

# Tu private key (para deploy y operaciones desde scripts)
# NUNCA commitees esto en el repo. NUNCA lo uses en producción sin cuidado.
PRIVATE_KEY=tu_private_key_aqui

# ============================================
# Contrato ChainRightERC721
# ============================================

# Address del contrato después de deployar
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ============================================
# 0G Compute Provider
# ============================================

# Provider address para text-to-image (se obtiene via provider-discovery)
# Si ya tenés uno, lo podés poner acá. Si no, el código lo descubre.
PROVIDER_ADDRESS=

# ============================================
# 0G Mainnet (Aristotle) - descomentá para producción
# ============================================

# NEXT_PUBLIC_RPC_URL=https://evmrpc.0g.ai
# NEXT_PUBLIC_CHAIN_ID=16661
# NEXT_PUBLIC_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
